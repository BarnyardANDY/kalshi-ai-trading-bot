# Kalshi API Configuration
# Get your API key from: https://trading.kalshi.com/settings/api
KALSHI_API_KEY=your_kalshi_api_key_here

# OpenRouter API Configuration — one key for any model on OpenRouter
# (the bot calls a single model per decision; choose it in your config)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI spending cap in USD per day (bot pauses AI analysis once reached)
DAILY_AI_COST_LIMIT=2

# Niche focus: trade only these market groups (comma list). Empty = all markets.
# Options: rotten_tomatoes, trump_mentions, weather
NICHES=rotten_tomatoes,trump_mentions,weather,sports,stocks
# Niches that predict + get graded but never trade (comma list)
SHADOW_NICHES=sports,stocks
# Sportsbook odds for the sports niche: free key at https://the-odds-api.com (500 requests/month)
ODDS_API_KEY=
# Minimum contracts traded for a niche market to be considered
NICHE_MIN_VOLUME=20
# Rotten Tomatoes: don't trade a film until it has this many critic reviews
RT_MIN_REVIEWS=5
# Re-ask the AI about a film at most this often (minutes) unless new reviews land
RT_REPRICE_MINUTES=60
# Niche positions hold to settlement; sell early only if the bid beats the bot's value by this much ($)
HOLD_EXIT_MARGIN=0.05
# Edge is measured against the ask + Kalshi fee (true/false); max ask-above-mid slippage ($); max days until a market closes
FEE_AWARE_EDGE=true
MAX_SLIPPAGE=0.03
MAX_DAYS_TO_CLOSE=30

# Trading Configuration
# Set to 'true' for live trading, 'false' for paper trading
LIVE_TRADING_ENABLED=false

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# Database Configuration
DATABASE_URL=sqlite:///trading_system.db

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15
