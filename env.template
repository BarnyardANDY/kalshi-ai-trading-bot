# Kalshi API Configuration
# Get your API key from: https://trading.kalshi.com/settings/api
KALSHI_API_KEY=your_kalshi_api_key_here

# OpenRouter API Configuration — one key for any model on OpenRouter
# (the bot calls a single model per decision; choose it in your config)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI spending cap in USD per day (bot pauses AI analysis once reached)
DAILY_AI_COST_LIMIT=2

# Niche focus: trade only these market groups (comma list). Empty = all markets.
# Options: rotten_tomatoes, trump_mentions
NICHES=rotten_tomatoes,trump_mentions
# Minimum contracts traded for a niche market to be considered
NICHE_MIN_VOLUME=20
# Rotten Tomatoes: don't trade a film until it has this many critic reviews
RT_MIN_REVIEWS=5

# Trading Configuration
# Set to 'true' for live trading, 'false' for paper trading
LIVE_TRADING_ENABLED=false

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# Database Configuration
DATABASE_URL=sqlite:///trading_system.db

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15
